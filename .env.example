# ─────────────────────────────────────────────────────────────
# TodoPDF — Variables de entorno (MVP)
# Copia este archivo a `.env` y ajusta los valores.
# docker compose lee automáticamente `.env` para sustituir ${VAR:-default}.
# ─────────────────────────────────────────────────────────────

# --- Backend / API ---
# Puerto del API.
#   - Docker: es el puerto INTERNO del contenedor (nginx proxya a backend:3000,
#     así que no lo cambies sin tocar también frontend/nginx.conf y el `expose`).
#   - Desarrollo local: se ajusta en backend/.env (por defecto 3200, porque el
#     3000/3100 pueden estar ocupados por otros proyectos de la máquina).
TODOPDF_PORT=3000
TODOPDF_NODE_ENV=production
# Secreto para firmar las cookies de sesión. Cámbialo por una cadena larga y aleatoria.
TODOPDF_SESSION_SECRET=
# Origen(es) permitidos para CORS (separados por coma).
TODOPDF_CORS_ORIGIN=
# Client ID público de Google Identity Services.
PUBLIC_GOOGLE_CLIENT_ID=
# La cookie debe ser Secure cuando la aplicación se sirve con HTTPS.
TODOPDF_COOKIE_SECURE=true
# Puerto HTTP expuesto del frontend (nginx).
TODOPDF_HTTP_PORT=8080
# URL pública usada para sitemap, robots.txt y la configuración del dominio OAuth.
PUBLIC_SITE_URL=https://tu-dominio.example
# Emails que tendrán rol admin. Separa varios por coma.
TODOPDF_ADMIN_EMAILS=
# El worker cleanup elimina archivos y filas después de este número de días.
TODOPDF_RETENTION_DAYS=14
# Intervalo del worker de limpieza (1 hora).
TODOPDF_RETENTION_INTERVAL_MS=3600000

# --- Base de datos (MariaDB) ---
TODOPDF_DB_HOST=db
TODOPDF_DB_PORT=3306
TODOPDF_DB_NAME=todopdf
TODOPDF_DB_USER=todopdf
TODOPDF_DB_PASSWORD=
TODOPDF_DB_ROOT_PASSWORD=

# --- Límites de subida (bytes) ---
# Invitados: procesamiento estricto en RAM, límite menor.
TODOPDF_MAX_UPLOAD_GUEST=26214400        # 25 MB
# Autenticados: archivos en disco, límite mayor.
TODOPDF_MAX_UPLOAD_AUTH=104857600        # 100 MB

# --- Conversión (Ghostscript / sharp) ---
TODOPDF_GS_TIMEOUT_MS=60000              # Timeout de Ghostscript
TODOPDF_MAX_PAGES=100                    # Páginas máximas por PDF
TODOPDF_JPEG_QUALITY=85                  # Calidad JPG de salida (1-100)
TODOPDF_IMAGE_DPI=150                    # Densidad de renderizado (DPI)
TODOPDF_MAX_CONCURRENCY=2                # Conversiones simultáneas (protege RAM)

# --- OCR de PDFs escaneados (tesseract, para PDF → Office) ---
# Si el PDF no tiene capa de texto se le aplica OCR, así el DOCX/ODT sale con
# la imagen de la página y con texto editable.
TODOPDF_OCR_LANGS=spa+eng                # Idiomas instalados en la imagen
TODOPDF_OCR_DPI=300                      # Resolución de rasterizado para OCR
TODOPDF_OCR_TIMEOUT_MS=120000            # Timeout por página
TODOPDF_OCR_MAX_PAGES=50                 # Tope de páginas con OCR (coste de CPU)
TODOPDF_OCR_MIN_CHARS_PER_PAGE=40        # Menos texto por página = se considera escaneo

# --- Storage (usuarios autenticados) ---
# Directorios montados como volumen en docker compose (/data).
TODOPDF_STORAGE_DIR=/data/storage
TODOPDF_TEMP_DIR=/data/tmp

# --- Flashcards (solo usuarios registrados) ---
TODOPDF_FLASHCARDS_MAX_CARDS=200         # Tarjetas máximas por mazo
TODOPDF_FLASHCARDS_TIMEOUT_MS=120000     # Timeout de exportación (el respaldo con LibreOffice es lento)
TODOPDF_FLASHCARDS_CONCURRENCY=1         # Exportaciones simultáneas
# Fuente TTF embebida en el PDF. Vacío = candidatos por defecto (DejaVu → Noto).
TODOPDF_FLASHCARDS_FONT=
TODOPDF_FLASHCARDS_FONT_BOLD=
