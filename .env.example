# ─────────────────────────────────────────────────────────────
# TodoPDF — Variables de entorno (MVP)
# Copia este archivo a `.env` y ajusta los valores.
# docker compose lee automáticamente `.env` para sustituir ${VAR:-default}.
# ─────────────────────────────────────────────────────────────

# --- Backend / API ---
TODOPDF_PORT=3000
TODOPDF_NODE_ENV=production
# Secreto para firmar las cookies de sesión. Cámbialo por una cadena larga y aleatoria.
TODOPDF_SESSION_SECRET=change-me-to-a-long-random-secret-string
# Origen(es) permitidos para CORS (separados por coma).
TODOPDF_CORS_ORIGIN=http://localhost:8080
# Puerto HTTP expuesto del frontend (nginx).
TODOPDF_HTTP_PORT=8080

# --- Base de datos (MariaDB) ---
TODOPDF_DB_HOST=db
TODOPDF_DB_PORT=3306
TODOPDF_DB_NAME=todopdf
TODOPDF_DB_USER=todopdf
TODOPDF_DB_PASSWORD=todopdf_secret_password
TODOPDF_DB_ROOT_PASSWORD=change-me-root-password

# --- Límites de subida (bytes) ---
# Invitados: procesamiento estricto en RAM, límite menor.
TODOPDF_MAX_UPLOAD_GUEST=26214400        # 25 MB
# Autenticados: archivos en disco, límite mayor.
TODOPDF_MAX_UPLOAD_AUTH=104857600        # 100 MB

# --- Conversión (Ghostscript / sharp) ---
TODOPDF_GS_TIMEOUT_MS=60000              # Timeout de Ghostscript
TODOPDF_MAX_PAGES=100                    # Páginas máximas por PDF
TODOPDF_JPEG_QUALITY=85                  # Calidad JPG de salida (1-100)
TODOPDF_IMAGE_DPI=150                    # Densidad de renderizado (DPI)
TODOPDF_MAX_CONCURRENCY=2                # Conversiones simultáneas (protege RAM)

# --- Storage (usuarios autenticados) ---
# Directorios montados como volumen en docker compose (/data).
TODOPDF_STORAGE_DIR=/data/storage
TODOPDF_TEMP_DIR=/data/tmp
