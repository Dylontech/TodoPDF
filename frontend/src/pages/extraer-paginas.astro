---
import Layout from '../layouts/Layout.astro';
import UploadForm from '../components/UploadForm.astro';
import type { Field } from '../lib/formTypes';

const fields: Field[] = [
  { name: 'pages', label: 'Páginas a extraer (ej. 1,3-5)', type: 'text', placeholder: '1,3-5' }
];
---

<Layout title="Extraer páginas">
  <section class="tool">
    <h1>Extraer páginas</h1>
    <p>
      Extrae solo las páginas que necesites de tu PDF en un único archivo.
      Indícalas separadas por comas; también admite rangos (ej. 1,3-5).
    </p>
    <UploadForm
      endpoint="/api/convert/pdf-extract"
      accept="application/pdf"
      fields={fields}
      submitLabel="Extraer"
    />
  </section>
</Layout>
