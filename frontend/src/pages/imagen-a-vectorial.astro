---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Imagen → Vectorial (SVG)" noindex>
  <section class="tool">
    <h1>📐 Imagen → Vectorial (SVG)</h1>
    <p>
      Convierte una imagen (PNG, JPG, WebP…) en un <strong>SVG vectorial</strong>
      escalable sin pérdida de calidad. Ideal para logos, dibujos o iconos.
      Esta sección es <strong>exclusiva para usuarios registrados</strong>.
    </p>

    <form id="vec-form" class="upload-form" autocomplete="off">
      <label class="field">
        <span>Elige una imagen (PNG, JPG, WebP, GIF, BMP…)</span>
        <input id="file-input" type="file" name="files" accept="image/*" required />
      </label>

      <fieldset class="field radio-group">
        <legend>Modo de vectorización</legend>
        <label class="radio">
          <input type="radio" name="mode" value="color" checked />
          <span>Color</span>
        </label>
        <label class="radio">
          <input type="radio" name="mode" value="binary" />
          <span>Blanco y negro</span>
        </label>
      </fieldset>

      <img id="preview" class="vec-preview" alt="Vista previa" hidden />
      <button type="submit" id="btn-process" class="btn-primary">Vectorizar</button>
      <p id="status" class="status" role="status"></p>
    </form>

    <div id="result" class="vec-result" hidden>
      <h2>Resultado</h2>
      <img id="result-img" class="vec-preview" alt="SVG vectorizado" />
      <p id="result-status" class="status"></p>
      <a id="result-link" class="btn-download" href="#">Descargar SVG</a>
    </div>
  </section>
</Layout>

<style>
  .vec-preview {
    max-width: 100%;
    max-height: 320px;
    border-radius: var(--radius);
    border: 1px dashed var(--muted);
    margin-top: 0.75rem;
    background:
      linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%),
      linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%);
    background-size: 20px 20px;
    background-position: 0 0, 10px 10px;
    background-color: #fff;
  }
  .vec-result {
    margin-top: 1rem;
    background: var(--surface);
    color: var(--text);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }
  .vec-result h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .vec-result .btn-download { display: inline-block; margin-top: 0.5rem; }
</style>

<script>
  /** Acceso tipado a elementos del DOM (lanza si no existen). */
  const $ = <T extends HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Elemento #${id} no encontrado`);
    return el as T;
  };

  /** Mensaje de un error desconocido (catch). */
  const errMsg = (err: unknown): string =>
    err instanceof Error ? err.message : 'Error inesperado.';

  async function main() {
    const status = $<HTMLParagraphElement>('status');
    const form = $<HTMLFormElement>('vec-form');
    const fileInput = $<HTMLInputElement>('file-input');

    // 1) Verificar sesión (redirige a login si no hay sesión)
    let me: { user: { id: number; email: string } | null } | null = null;
    try {
      const r = await fetch('/api/auth/me', { credentials: 'include' });
      me = await r.json();
    } catch {
      /* sin sesión */
    }
    if (!me || !me.user) {
      location.href = '/login';
      return;
    }

    // 2) Vista previa del original
    fileInput.addEventListener('change', () => {
      const file = fileInput.files && fileInput.files[0];
      const preview = $<HTMLImageElement>('preview');
      if (!file) {
        preview.hidden = true;
        preview.removeAttribute('src');
        return;
      }
      preview.src = URL.createObjectURL(file);
      preview.alt = file.name;
      preview.hidden = false;
    });

    // 3) Vectorizar
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('error');
      $<HTMLDivElement>('result').hidden = true;

      const file = fileInput.files && fileInput.files[0];
      if (!file) {
        status.textContent = 'Selecciona una imagen primero.';
        status.classList.add('error');
        return;
      }

      const modeInput = form.querySelector<HTMLInputElement>('input[name="mode"]:checked');
      const mode = modeInput ? modeInput.value : 'color';

      const btn = $<HTMLButtonElement>('btn-process');
      btn.disabled = true;
      btn.textContent = 'Vectorizando… (puede tardar unos segundos)';

      try {
        const fd = new FormData();
        fd.append('files', file);
        fd.append('mode', mode);
        const res = await fetch('/api/vectorize', {
          method: 'POST',
          body: fd,
          credentials: 'include'
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || 'No se pudo vectorizar la imagen.');

        const url = `/api/convert/${body.id}/download`;
        $<HTMLImageElement>('result-img').src = url;
        $<HTMLAnchorElement>('result-link').href = url;
        $<HTMLParagraphElement>('result-status').textContent =
          'Imagen vectorizada. Guardada en tu historial.';
        $<HTMLDivElement>('result').hidden = false;
      } catch (err) {
        status.textContent = errMsg(err);
        status.classList.add('error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Vectorizar';
      }
    });
  }

  main();
</script>
