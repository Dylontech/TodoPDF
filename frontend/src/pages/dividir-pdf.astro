---
import Layout from '../layouts/Layout.astro';
import UploadForm from '../components/UploadForm.astro';
import type { Field } from '../lib/formTypes';

// Modos: rangos | cada página | cada N páginas | por tamaño (MB)
const fields: Field[] = [
  {
    name: 'mode',
    label: 'Modo de división',
    type: 'radio',
    default: 'ranges',
    options: [
      { value: 'ranges', label: 'Rangos personalizados' },
      { value: 'pages', label: 'Cada página individual' },
      { value: 'every', label: 'Cada N páginas' },
      { value: 'size', label: 'Por tamaño (MB)' }
    ]
  },
  { name: 'ranges', label: 'Rangos (ej. 1-3,5,8-10)', type: 'text', placeholder: '1-3,5,8-10', dependsOn: { field: 'mode', value: 'ranges' } },
  { name: 'every', label: 'Páginas por parte', type: 'number', min: 1, default: 2, dependsOn: { field: 'mode', value: 'every' } },
  { name: 'sizeMB', label: 'Tamaño máximo por parte (MB)', type: 'number', min: 0.1, step: 0.1, default: 5, dependsOn: { field: 'mode', value: 'size' } }
];
---

<Layout title="Dividir PDF">
  <section class="tool">
    <h1>Dividir PDF</h1>
    <p>
      Divide tu PDF en varios archivos: por rangos, página a página, en partes de
      tamaño fijo o limitando el peso de cada parte. Recibirás un ZIP.
    </p>
    <UploadForm
      endpoint="/api/convert/pdf-split"
      accept="application/pdf"
      fields={fields}
      submitLabel="Dividir"
    />
  </section>
</Layout>
