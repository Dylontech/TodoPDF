---
import Layout from '../layouts/Layout.astro';
import OrganizeForm from '../components/OrganizeForm.astro';
---

<Layout title="Organizar páginas">
  <section class="tool">
    <h1>Organizar páginas</h1>
    <p>
      Reordena las páginas de tu PDF arrastrándolas. Primero se analiza el
      documento y luego puedes mover cada página al lugar que quieras.
    </p>
    <OrganizeForm />
  </section>
</Layout>
