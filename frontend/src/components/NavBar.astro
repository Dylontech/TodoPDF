---
// Barra de navegación.
// El estado de sesión se resuelve en el cliente consultando /api/auth/me
// (las cookies de sesión viajan automáticamente con credentials: include).
---

<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand">📄 TodoPDF</a>
    <nav class="nav-links">
      <a href="/pdf-a-jpg">PDF → Imágenes</a>
      <a href="/imagenes-a-pdf">Imágenes → PDF</a>
      <a href="/pdf-a-office">PDF → Office</a>
      <a href="/office-a-pdf">Office → PDF</a>
      <details class="nav-dropdown">
        <summary>Herramientas PDF <span class="caret">▾</span></summary>
        <div class="dropdown-menu">
          <a href="/dividir-pdf">Dividir PDF</a>
          <a href="/extraer-paginas">Extraer páginas</a>
          <a href="/fusionar-pdf">Fusionar PDF</a>
          <a href="/insertar-paginas">Insertar páginas</a>
          <a href="/rotar-paginas">Rotar páginas</a>
          <a href="/eliminar-paginas">Eliminar páginas</a>
          <a href="/organizar-paginas">Organizar páginas</a>
          <a href="/comprimir-pdf">Comprimir PDF</a>
        </div>
      </details>
    </nav>
    <div id="nav-auth" class="nav-auth">
      <a href="/login">Iniciar sesión</a>
      <a href="/register" class="btn-outline">Registrarse</a>
    </div>
  </div>
</header>

<script>
  // Actualiza la navegación según haya sesión o no.
  async function updateNav() {
    const el = document.getElementById('nav-auth');
    if (!el) return;
    try {
      const res = await fetch('/api/auth/me', { credentials: 'include' });
      const data = await res.json();
      if (res.ok && data.user) {
        el.innerHTML = `
          <a href="/historial">Historial</a>
          <button id="btn-logout" class="btn-outline">Cerrar sesión</button>`;
        document.getElementById('btn-logout')?.addEventListener('click', async () => {
          await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
          location.href = '/';
        });
      }
    } catch {
      /* sin sesión: se mantiene el enlace de login */
    }
  }
  updateNav();
</script>
