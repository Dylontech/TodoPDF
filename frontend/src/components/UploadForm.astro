---
// Formulario de subida reutilizable.
// Props:
//   endpoint        → ruta API (ej. /api/convert/pdf-to-images)
//   accept          → atributo accept del input (ej. application/pdf)
//   multiple        → admite varios archivos
//   formatSelector  → muestra selector de formato de salida
//   formats         → [{ value, label }] para el selector
//   fields          → [{ name, label, type, options?, placeholder?, default?, min?, step?, dependsOn? }]
//   secondaryFiles  → [{ field, label, accept }] (inputs de archivo extra)
//   submitLabel     → texto del botón

import type { Field, FieldOption, SecondaryFile } from '../lib/formTypes';

interface Props {
  endpoint: string;
  accept: string;
  multiple?: boolean;
  formatSelector?: boolean;
  formats?: FieldOption[];
  fields?: Field[];
  secondaryFiles?: SecondaryFile[];
  submitLabel?: string;
}

const {
  endpoint,
  accept,
  multiple = false,
  formatSelector = false,
  formats = [],
  // Campos adicionales (texto/número/select/radio) que se envían al endpoint.
  fields = [],
  // Inputs de archivo adicionales con nombre propio (p. ej. Insertar páginas: campo 'insert').
  secondaryFiles = [],
  submitLabel = 'Convertir'
} = Astro.props;
---

<form id="upload-form" class="upload-form">
  <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Subir archivos">
    <input type="file" id="file-input" accept={accept} {multiple} hidden />
    <p class="dropzone-hint">Arrastra tus archivos aquí o haz clic para elegirlos</p>
    <p id="file-info" class="file-info"></p>
  </div>

  {formatSelector && (
    <label class="field">
      <span>Formato de salida</span>
      <select id="format">
        {formats.map((f) => <option value={f.value}>{f.label}</option>)}
      </select>
    </label>
  )}

  {secondaryFiles.length > 0 && secondaryFiles.map((sf) => (
    <label class="field">
      <span>{sf.label}</span>
      <input type="file" id={`file-${sf.field}`} accept={sf.accept} />
    </label>
  ))}

  {fields.length > 0 && (
    <div class="fields">
      {fields.map((f) => (
        <div
          class="field"
          data-field-group={f.name}
          data-depends-on={f.dependsOn ? `${f.dependsOn.field}:${f.dependsOn.value}` : ''}
        >
          {f.type === 'radio' ? (
            <fieldset class="radio-group">
              <legend>{f.label}</legend>
              {f.options?.map((o) => (
                <label class="radio">
                  <input
                    type="radio"
                    name={f.name}
                    value={o.value}
                    checked={o.value === (f.default || f.options?.[0]?.value)}
                  />
                  <span>{o.label}</span>
                </label>
              ))}
            </fieldset>
          ) : (
            <>
              <span>{f.label}</span>
              {f.type === 'select' ? (
                <select name={f.name}>
                  {f.options?.map((o) => (
                    <option value={o.value} selected={o.value === f.default}>{o.label}</option>
                  ))}
                </select>
              ) : (
                <input
                  type={f.type === 'number' ? 'number' : 'text'}
                  name={f.name}
                  placeholder={f.placeholder}
                  value={f.default || ''}
                  min={f.min}
                  step={f.step}
                />
              )}
            </>
          )}
        </div>
      ))}
    </div>
  )}

  <button type="submit" id="submit-btn" class="btn-primary">{submitLabel}</button>
  <p id="status" class="status" role="status"></p>
</form>

<div id="result" class="result" hidden></div>

<script define:vars={{ endpoint, formatSelector, fields, secondaryFiles }}>
  const form = document.getElementById('upload-form');
  const input = document.getElementById('file-input');
  const dropzone = document.getElementById('dropzone');
  const info = document.getElementById('file-info');
  const statusEl = document.getElementById('status');
  const submitBtn = document.getElementById('submit-btn');
  const result = document.getElementById('result');

  // ── Selección de archivos (clic + arrastrar y soltar) ─────
  dropzone.addEventListener('click', () => input.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
  });

  ['dragover', 'dragenter'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('dragging'); })
  );
  ['dragleave', 'drop'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.remove('dragging'); })
  );

  dropzone.addEventListener('drop', (e) => {
    if (e.dataTransfer?.files?.length) {
      input.files = e.dataTransfer.files;
      updateInfo();
    }
  });
  input.addEventListener('change', updateInfo);

  function updateInfo() {
    const files = [...input.files];
    info.textContent = files.length
      ? files.map((f) => `${f.name} (${(f.size / 1048576).toFixed(2)} MB)`).join(', ')
      : '';
  }

  // ── Envío a la API ─────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const files = [...input.files];
    if (files.length === 0) { setStatus('Selecciona al menos un archivo.', true); return; }

    setStatus('Convirtiendo…');
    submitBtn.disabled = true;
    try {
      const fd = new FormData();
      files.forEach((f) => fd.append('files', f));

      // Archivos adicionales (p. ej. PDF a insertar).
      secondaryFiles.forEach((sf) => {
        const inp = document.getElementById(`file-${sf.field}`);
        if (inp && inp.files.length) {
          for (const f of inp.files) fd.append(sf.field, f);
        }
      });

      // Campos adicionales (texto/número/select/radio).
      fields.forEach((f) => {
        const sel = f.type === 'radio'
          ? document.querySelector(`input[name="${f.name}"]:checked`)
          : document.querySelector(`[name="${f.name}"]`);
        if (sel && sel.value !== '') fd.append(f.name, sel.value);
      });

      if (formatSelector) fd.append('format', document.getElementById('format').value);

      const res = await fetch(endpoint, { method: 'POST', body: fd, credentials: 'include' });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || `Error ${res.status}`);
      }

      const ctype = res.headers.get('content-type') || '';

      // Flujo autenticado → JSON { id } → descarga vía /download
      if (ctype.includes('application/json')) {
        const data = await res.json();
        showResultLink(`/api/convert/${data.id}/download`, 'Descargar resultado');
        setStatus('Conversión guardada en tu historial.');
      }
      // Flujo invitado → el archivo llega directamente (blob)
      else {
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const name = filenameFromDisposition(res.headers.get('content-disposition')) || 'resultado';
        showResultLink(url, name, true);
        setStatus('¡Conversión completada!');
      }
    } catch (err) {
      setStatus(err.message || 'Error al convertir.', true);
    } finally {
      submitBtn.disabled = false;
    }
  });

  // ── Helpers de UI ──────────────────────────────────────────
  function setStatus(msg, isError = false) {
    statusEl.textContent = msg;
    statusEl.classList.toggle('error', isError);
  }

  function showResultLink(url, label, download = false) {
    result.innerHTML = '';
    result.hidden = false;
    const a = document.createElement('a');
    a.href = url;
    a.className = 'btn-download';
    a.textContent = `⬇ ${label}`;
    if (download) a.setAttribute('download', label);
    result.appendChild(a);
  }

  function filenameFromDisposition(header) {
    if (!header) return null;
    const m = header.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
    return m ? decodeURIComponent(m[1]) : null;
  }

  // ── Campos condicionales (mostrar/ocultar según dependencia) ──
  function syncDepends() {
    document.querySelectorAll('[data-field-group]').forEach((group) => {
      const dep = group.dataset.dependsOn; // formato "campo:valor"
      if (!dep) return;
      const [name, value] = dep.split(':');
      const el = document.querySelector(`[name="${name}"]`);
      let active = false;
      if (el) {
        active = el.type === 'radio' ? el.checked && el.value === value : el.value === value;
      }
      group.hidden = !active;
      group.querySelectorAll('input, select').forEach((inp) => { inp.disabled = !active; });
    });
  }
  document.querySelectorAll('[name]').forEach((el) => el.addEventListener('change', syncDepends));
  syncDepends();
</script>
