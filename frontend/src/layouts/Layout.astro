---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';

// Layout base: cabecera, contenido y pie.
// `noindex` (opcional): añade meta robots noindex para páginas privadas
// (login, registro, historial y herramientas solo para usuarios).
const { title = 'TodoPDF', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Convierte PDFs e imágenes de forma privada y segura. Autoalojado: tus archivos nunca se suben a la nube."
    />
    <title>{title} · TodoPDF</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📄</text></svg>"
    />
  </head>
  <body>
    <NavBar />
    <main class="container">
      <slot />
    </main>
    <footer class="footer">
      <p>TodoPDF · Procesamiento privado: invitados en memoria o en un espacio temporal aislado que se elimina al instante.</p>
      <nav class="footer-links" aria-label="Información legal">
        <a href="/privacidad">Aviso de privacidad</a>
        <a href="/terminos">Términos y condiciones</a>
        <a href="/LICENSE">Licencia MIT</a>
      </nav>
      <section class="footer-about" aria-labelledby="footer-about-title">
        <h2 id="footer-about-title">Más de DylonTech</h2>
        <p>Visita <a href="https://www.dylontech.com" target="_blank" rel="noopener noreferrer">dylontech.com</a> para conocer otros proyectos y lo que estamos desarrollando.</p>
        <nav class="footer-links" aria-label="Contacto y proyecto">
          <a href="mailto:dylongabrielm@dylontech.com">Contacto: dylongabrielm@dylontech.com</a>
          <a href="https://github.com/Dylontech/TodoPDF" target="_blank" rel="noopener noreferrer">TodoPDF en GitHub</a>
        </nav>
        <p class="footer-ai-note">TodoPDF fue desarrollado con ayuda de inteligencia artificial.</p>
      </section>
    </footer>
    <div id="legal-notice" class="modal-overlay legal-notice" role="dialog" aria-modal="true" aria-labelledby="legal-notice-title" aria-describedby="legal-notice-copy" hidden>
      <section class="modal-panel">
        <h2 id="legal-notice-title">Antes de continuar</h2>
        <p id="legal-notice-copy">Al usar TodoPDF aceptas el <a href="/privacidad">aviso de privacidad</a> y los <a href="/terminos">términos y condiciones</a>. Eres responsable de los archivos que subas y debes tener derecho y autorización para utilizarlos.</p>
        <p>Los archivos de invitados se procesan en memoria o en espacio temporal; al iniciar sesión, los resultados pueden almacenarse en el servidor y aparecer en tu historial.</p>
        <div class="modal-actions">
          <button id="accept-legal-notice" type="button" class="btn-primary">Aceptar y continuar</button>
        </div>
      </section>
    </div>
    <script is:inline>
      const legalNotice = document.getElementById('legal-notice');
      const legalAccept = document.getElementById('accept-legal-notice');
      const legalNoticeKey = 'todopdf-legal-notice-accepted-v1';
      try {
        if (localStorage.getItem(legalNoticeKey) !== 'yes') legalNotice.hidden = false;
      } catch {
        legalNotice.hidden = false;
      }
      legalAccept.addEventListener('click', () => {
        try { localStorage.setItem(legalNoticeKey, 'yes'); } catch {}
        legalNotice.hidden = true;
      });
      if (!legalNotice.hidden) legalAccept.focus();
    </script>
  </body>
</html>
