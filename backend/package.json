{
  "name": "todopdf-backend",
  "version": "1.0.0",
  "description": "API REST de TodoPDF — conversión de PDFs e imágenes con flujos privados (RAM) y autenticados (disco + historial).",
  "main": "src/server.js",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.4"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "sharp@0.33.5": true
  }
}
